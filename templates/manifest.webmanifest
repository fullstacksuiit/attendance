{% load static %}{
  "name": "AttendEase — Attendance Manager",
  "short_name": "AttendEase",
  "description": "Mark daily attendance, track employees and send monthly reports.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f5f6f8",
  "theme_color": "#4f46e5",
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "{% static 'img/icon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'img/icon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'img/icon-maskable-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mark attendance",
      "short_name": "Attendance",
      "url": "/attendance/?source=pwa",
      "icons": [{ "src": "{% static 'img/icon-192.png' %}", "sizes": "192x192" }]
    },
    {
      "name": "Monthly report",
      "short_name": "Reports",
      "url": "/reports/monthly/?source=pwa",
      "icons": [{ "src": "{% static 'img/icon-192.png' %}", "sizes": "192x192" }]
    }
  ]
}
