# Copy to `.env` and fill in. Without EMAIL_HOST_USER the app prints mails to
# the terminal instead of sending them, so you can test without SMTP.

DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Kolkata

# --- Email (Gmail example) ---
# For Gmail you must use an App Password, not your normal password:
# Google Account → Security → 2-Step Verification → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HR Team <your-email@gmail.com>

# Force the console backend even when SMTP credentials are set:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
